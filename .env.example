# Dedicated browser profile outside the repository.
# WASEDA_PORTAL_PROFILE_DIR=/Users/you/.waseda-portal-mcp/chrome-profile

# In-memory normalized-data cache only (default: true, 5 minutes).
WASEDA_PORTAL_CACHE=true
WASEDA_PORTAL_CACHE_TTL_MS=300000

# Operational defaults.
WASEDA_PORTAL_HEADLESS=true
WASEDA_PORTAL_TIMEOUT_MS=30000
WASEDA_PORTAL_MASK_COURSE_NAMES=true
