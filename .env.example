# Dedicated browser profile outside the repository.
# WASEDA_PORTAL_PROFILE_DIR=/Users/you/.waseda-portal-mcp/chrome-profile
# WASEDA_PORTAL_AUTH_STATE_PATH=/Users/you/.waseda-portal-mcp/auth-state.json
# WASEDA_PORTAL_MAPPING_CACHE_PATH=/Users/you/.waseda-portal-mcp/cache/course-syllabus-map.json

# In-memory normalized-data cache only (default: true, 5 minutes).
WASEDA_PORTAL_CACHE=true
WASEDA_PORTAL_CACHE_TTL_MS=300000

# Public catalog deployment: public Web Syllabus and academic calendar only.
# No authenticated session, no personal data, safe to share with several people.
# WASEDA_PORTAL_PUBLIC_ONLY=true
# WASEDA_PORTAL_HTTP_HOST=0.0.0.0
# WASEDA_PORTAL_HTTP_PORT=8787
# WASEDA_PORTAL_HTTP_ALLOWED_HOSTS=syllabus.example.invalid
# WASEDA_PORTAL_HTTP_ALLOWED_ORIGINS=syllabus.example.invalid
# WASEDA_PORTAL_HTTP_REQUESTS_PER_MINUTE=20
# WASEDA_PORTAL_HTTP_MAX_CONCURRENT_REQUESTS=4

# Operational defaults.
WASEDA_PORTAL_HEADLESS=true
# Empty selects Playwright's bundled Chromium (what container images ship).
WASEDA_PORTAL_BROWSER_CHANNEL=chrome
WASEDA_PORTAL_TIMEOUT_MS=30000
WASEDA_PORTAL_MASK_COURSE_NAMES=true
WASEDA_PORTAL_MIN_ACCESS_INTERVAL_MS=250
# Optional upper bound for a constrained run.
# WASEDA_PORTAL_MAX_COURSES=1
WASEDA_PORTAL_MAX_SYLLABUS_CANDIDATES=10
WASEDA_PORTAL_MAX_ASSIGNMENT_DETAILS=10
