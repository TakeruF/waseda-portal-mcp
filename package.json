{
  "name": "waseda-portal-mcp",
  "version": "0.1.0",
  "description": "Unofficial read-only MCP server for Waseda University portals",
  "type": "module",
  "bin": {
    "waseda-portal-mcp": "dist/cli.js"
  },
  "main": "./dist/mcp-server.js",
  "exports": "./dist/mcp-server.js",
  "files": [
    "dist",
    "public",
    "docs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "auth": "tsx src/cli.ts auth",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "dev:public": "tsx src/cli.ts serve-http --public-only",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "serve:public": "node dist/cli.js serve-http --public-only",
    "start": "node dist/cli.js",
    "test": "vitest run tests/unit tests/integration",
    "test:e2e:authenticated": "vitest run tests/e2e/mcp-client.live.test.ts --no-file-parallelism --maxWorkers=1",
    "test:e2e:catalog": "vitest run tests/e2e/syllabus-catalog-client.live.test.ts --no-file-parallelism --maxWorkers=1",
    "test:live": "npm run test:live:authenticated",
    "test:live:auth-state": "vitest run tests/live/auth-state.live.test.ts --no-file-parallelism --maxWorkers=1",
    "test:live:authenticated": "vitest run tests/live/authenticated.live.test.ts --no-file-parallelism --maxWorkers=1",
    "test:live:catalog": "vitest run tests/live/syllabus-catalog.live.test.ts --no-file-parallelism --maxWorkers=1",
    "test:live:public": "vitest run tests/live/public-catalog.live.test.ts --no-file-parallelism --maxWorkers=1",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "waseda",
    "moodle",
    "read-only"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.19.15",
    "eslint": "^10.0.1",
    "prettier": "^3.9.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
